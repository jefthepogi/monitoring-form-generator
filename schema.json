{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SPMPDocumentData",
    "type": "object",
    "properties": {
      "header_info": {
        "type": "object",
        "properties": {
          "institution": { "type": "string" },
          "location": { "type": "string" },
          "department": { "type": "string" },
          "form_type": { "type": "string" },
          "issue_no": { "type": "string" },
          "revision_no": { "type": "string" },
          "effective_date": { "type": "string" },
          "page_info": { "type": "string" }
        },
        "required": ["institution", "location", "department", "form_type", "issue_no", "revision_no", "effective_date", "page_info"]
      },
      "project_info": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "candidates": { "type": "array", "items": { "type": "string" } },
          "degree": { "type": "string" },
          "school_year": { "type": "string" },
          "term": { "type": "string" }
        },
        "required": ["title", "candidates", "degree", "school_year", "term"]
      },
      "monitoring_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "section_id": { "type": "string" },
            "title": { "type": "string" },
            "is_header": { "type": "boolean" },
            "corrections": { "type": "string" },
            "page_no": { "type": "string" },
            "client_name": { "type": "string" },
            "complied": { "type": "boolean" },
            "remarks": { "type": "string" }
          },
          "required": ["title"]
        }
      },
      "signatures": {
        "type": "object",
        "properties": {
          "researchers": { "type": "array", "items": { "type": "string" } },
          "client_name": { "type": "string" },
          "client_title": { "type": "string" },
          "professor_name": { "type": "string" },
          "professor_title": { "type": "string" }
        },
        "required": ["researchers", "client_name", "client_title", "professor_name", "professor_title"]
      }
    },
    "required": ["header_info", "project_info", "monitoring_items", "signatures"]
  }